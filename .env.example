# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Prisma / CV-TR-01a role separation
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Production: pooled URL for the restricted SQL-created `complyvault_app` role.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ria-compliance-tool"
# Production: non-pooler/direct URL for the Neon owner migration role.
# Never use this owner URL as the application DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/ria-compliance-tool"
# CI only: disposable Neon branch URL for `complyvault_app`; verifies that
# UPDATE/DELETE/TRUNCATE on RecordSeal fail at the PostgreSQL layer.
RECORD_SEAL_PRIVILEGE_TEST_DATABASE_URL=""
# Vercel builds set PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 during migrate by default (Neon pooler P1002); set PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=0 in Vercel env to keep advisory locking.

# CV-TR-01 sealed Object Lock bucket (separate from working S3_BUCKET_NAME / R2)
SEALED_S3_BUCKET_NAME=""
# Must be set explicitly to COMPLIANCE for production seals. Unset/other → GOVERNANCE (fail closed).
SEALED_OBJECT_LOCK_MODE="GOVERNANCE"

# IntegrationHub (Epic 6)
# Redis URL for BullMQ job queue
# Local: redis://localhost:6379
# Upstash (TLS): rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL="redis://default:password@host:6379"
# AES-256 key for OAuth token encryption (min 32 chars)
INTEGRATION_ENCRYPTION_KEY=""
# Secret for cron job auth (Bearer token)
CRON_SECRET=""
# Comma-separated emails allowed to access /internal/ops dashboard
OPS_ALLOWED_EMAILS="contact@complyvaut.co"

# Zoom OAuth (Epic 1 Story 1.1)
# Create app at https://marketplace.zoom.us/ — OAuth app type
# Add redirect URL: {NEXT_PUBLIC_APP_URL}/api/integrations/zoom/callback
# Scopes: match SCOPES in src/server/integrations/adapters/zoom.ts (includes list_user_recordings + list_user_recordings:admin when Zoom exposes them).
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

ZOOM_WEBHOOK_SECRET=""
ZOOM_WEBHOOK_URL="https://app.complyvault.co/api/webhooks/zoom"

# Microsoft Teams OAuth (Epic 1 Story 1.4)
# Azure AD app registration: https://portal.azure.com
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/teams/callback
# API permissions: OnlineMeetings.Read, OnlineMeetingTranscript.Read.All, User.Read
TEAMS_CLIENT_ID=""
TEAMS_CLIENT_SECRET=""
TEAMS_TENANT_ID="common"
TEAMS_WEBHOOK_CLIENT_STATE="complyvault"

# M365 Mail (Epic B) — dedicated Azure app for email ingestion (no Teams vars required)
# Create app registration in Azure Portal, add Mail.Read permission, create client secret.
# Redirect URIs (replace with your Vercel/staging URL):
#   {NEXT_PUBLIC_APP_URL}/api/integrations/m365-mail/callback
#   {NEXT_PUBLIC_APP_URL}/api/integrations/m365-mail/admin-consent/callback
M365_MAIL_CLIENT_ID=""
M365_MAIL_CLIENT_SECRET=""
M365_MAIL_TENANT_ID=""   # your Azure tenant GUID for application mode; omit for delegated-only

# SharePoint / OneDrive (Epic 2) reuses the Teams Azure app: add delegated permissions
# Files.ReadWrite.All, Sites.ReadWrite.All (admin consent in Entra)

# Gmail Mail — dedicated Google Cloud OAuth app for email ingestion (delegated only)
# Create OAuth client at https://console.cloud.google.com/apis/credentials (Web application)
# Enable the Gmail API and add scope https://www.googleapis.com/auth/gmail.readonly
# (restricted scope: keep the app in Testing mode with your tester added; production needs Google verification)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/gmail-mail/callback
GMAIL_MAIL_CLIENT_ID=""
GMAIL_MAIL_CLIENT_SECRET=""

# Zoho CRM (Epic 3.0)
# Scopes: ZohoCRM.modules.contacts.READ, ZohoCRM.modules.notes.CREATE, ZohoCRM.users.READ, ZohoCRM.org.READ
# EU/IN: set ZOHO_CRM_ACCOUNTS_DOMAIN to https://accounts.zoho.eu (etc.)
ZOHO_CRM_CLIENT_ID=""
ZOHO_CRM_CLIENT_SECRET=""
# ZOHO_CRM_ACCOUNTS_DOMAIN="https://accounts.zoho.com"

# SEC IAPD / Form ADV lookup (Compliance Cockpit CRD auto-population)
SEC_API_KEY=""
NEXT_PUBLIC_DEMO_MODE="false"
# Partner-demo mailbox label (hides test Gmail addresses on Integrations)
# NEXT_PUBLIC_DEMO_MAILBOX_LABEL="compliance@demo.complyvault.co"

# Email Intelligence (Phases 1–3): client correspondence, classify→flag, Ask over email.
# Set either server or public flag to "true" to enable.
EMAIL_INTELLIGENCE_ENABLED="false"
NEXT_PUBLIC_EMAIL_INTELLIGENCE="false"
# Hybrid Ask retrieval (keyword + pgvector). Enable after migrate + embed backfill.
ASK_HYBRID_RETRIEVAL="false"
# Release 1 AdvizorStack demo surfaces (Needs Attention, candidate pack, portfolio, etc.)
RELEASE1_DEMO_ENABLED="false"
NEXT_PUBLIC_RELEASE1_DEMO="false"

# Ask ComplyVault (CV-FEAT-014) — optional overrides
# Per-user, per-workspace soft cap on questions per 60s window (default 10)
ASK_RATE_LIMIT_PER_MIN="10"
# Optional override for evidence-block size cap, in chars (default 12000)
ASK_MAX_CONTEXT_TOKENS="12000"
