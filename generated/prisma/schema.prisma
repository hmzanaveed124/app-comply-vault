// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Unpooled/direct URL for migrations (required on Neon when DATABASE_URL uses `-pooler`).
  /// Omit in .env only for local Postgres by setting DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ============================================
// Multi-Tenant Workspace Models (ADR-001)
// ============================================

model Workspace {
  id                              String        @id @default(cuid())
  name                            String
  /// Years of retention measured from fiscal year end (Rule 204-2). Floor is 5; never shorten.
  retentionYears                  Int           @default(5)
  /// Month (1-12) on which the firm's fiscal year ends. Default December.
  fiscalYearEndMonth              Int           @default(12)
  /// IANA timezone for fiscal date-only arithmetic (e.g. America/Phoenix).
  fiscalTimezone                  String        @default("America/New_York")
  /// Meeting source-media policy. Null until OWNER_CCO decides (CV-TR-06).
  mediaPosture                    MediaPosture?
  postureSetById                  String?
  postureSetAt                    DateTime?
  /// CV-TR-04a: true for workspaces migrated onto fiscal-year anchoring until OWNER_CCO dismisses the notice.
  retentionAnchoringNoticePending Boolean       @default(false)
  legalHold                       Boolean       @default(false)
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  // Billing fields
  billingStatus         BillingStatus   @default(PILOT)
  planTier              PlanTier        @default(FREE)
  billingCurrency       BillingCurrency @default(USD)
  pilotStartDate        DateTime?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  subscriptionStartDate DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  onboardingType        String?
  onboardingPaidAt      DateTime?

  // Relations
  users                     UserWorkspace[]
  meetings                  Meeting[]
  auditEvents               AuditEvent[]
  invitations               Invitation[]
  flags                     Flag[]
  resolutionRecords         ResolutionRecord[]
  integrationCredentials    IntegrationCredential[]
  integrationConfigs        IntegrationConfig[]
  firmProfile               FirmProfile?
  evidenceItems             EvidenceItem[]
  clients                   Client[]
  clientHouseholds          ClientHousehold[]
  clientActivities          ClientActivity[]
  mailboxConnections        MailboxConnection[]
  communicationThreads      CommunicationThread[]
  emailAliases              EmailAlias[]
  emailTriageItems          EmailTriageItem[]
  ingestJobs                IngestJob[]
  evidenceClassifications   EvidenceClassification[]
  evidenceEmbeddings        EvidenceEmbedding[]
  parkedIngests             ParkedIngest[]
  recordSeals               RecordSeal[]
  candidateResponsePacks    CandidateResponsePack[]
  indexCoverageManifests    IndexCoverageManifest[]
  supervisorySamplingConfig SupervisorySamplingConfig?

  @@index([createdAt])
}

enum SupervisoryOutcome {
  CLEARED
  ROUTINE_SAMPLE
  ESCALATED
  HELD
  PARKED
}

enum SupervisoryHoldReason {
  ACTIVE_POLICY_UNAVAILABLE
  ORIGINAL_SOURCE_UNAVAILABLE
  ADVISER_UNRESOLVED
  REQUIRED_CLIENT_CONTEXT_UNRESOLVED
  PROCESSING_FAILED
  CONFIDENCE_BELOW_THRESHOLD
  MATERIAL_CONTEXT_CONTRADICTORY
}

/// CV-XR-01a — candidate examination-response pack (never labelled "responsive").
enum CandidatePackStatus {
  DRAFT_SCOPE
  SCOPE_CONFIRMED
  GENERATED
  APPROVED
}

model CandidateResponsePack {
  id                String              @id @default(cuid())
  workspaceId       String
  requestText       String              @db.Text
  interpretedScope  Json
  confirmedScope    Json?
  confirmedAt       DateTime?
  confirmedByUserId String?
  status            CandidatePackStatus @default(DRAFT_SCOPE)
  coverageStatement Json?
  retrievalBasis    String?             @db.Text
  meetingIds        String[]            @default([])
  emailEvidenceIds  String[]            @default([])
  auditChainRootId  String?
  exportManifestSha String?
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

/// CV-AX-06 — per-workspace index coverage for honest-miss answers.
model IndexCoverageManifest {
  id               String    @id @default(cuid())
  workspaceId      String
  sources          Json
  gapPeriods       Json
  unindexedSources Json
  lastIndexedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([workspaceId])
}

enum BillingStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// CV-TR-06: explicit decision whether meeting source media is retained after transcription.
enum MediaPosture {
  RETAIN
  DISCARD
}

/// CV-TR-06a: automated ingest refused because no media posture decision existed.
enum ParkedIngestStatus {
  PARKED
  REPLAY_REQUESTED
  INGESTED
}

/// Durable record of a refused automated ingest — replayable work item, not just a log line.
/// These rows are proto coverage gaps and feed the CV-COV-06 coverage queue when it lands.
model ParkedIngest {
  id                  String             @id @default(cuid())
  workspaceId         String
  /// "zoom" | "teams"
  source              String
  /// External recording/meeting identifier at the source system.
  externalRef         String
  /// Original job payload, sufficient to re-publish the ingest job unchanged.
  payload             Json
  /// Meeting start time at the source, when known. Ages the gap.
  occurredAt          DateTime?
  status              ParkedIngestStatus @default(PARKED)
  parkedAt            DateTime           @default(now())
  replayRequestedAt   DateTime?
  replayRequestedById String?
  /// Set when a later successful ingest matches this row.
  meetingId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, externalRef])
  @@index([workspaceId, status])
  @@index([workspaceId, parkedAt])
}

enum PlanTier {
  FREE
  SOLO
  TEAM
}

enum BillingCurrency {
  USD
  GBP
}

enum WorkspaceRole {
  OWNER_CCO
  MEMBER
  ADVISOR
}

model UserWorkspace {
  userId                String
  workspaceId           String
  role                  WorkspaceRole
  onboardingDismissedAt DateTime?
  removedAt             DateTime?
  removedById           String?

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  removedBy User?     @relation("UserWorkspaceRemovedBy", fields: [removedById], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId, removedAt])
}

// ============================================
// Meeting Models
// ============================================

enum MeetingStatus {
  UPLOADING
  PROCESSING
  DRAFT_READY
  DRAFT
  ADVISOR_CERTIFIED
  CM_REVIEWED
  CCO_SIGNED_OFF
  FINALIZED
}

enum FinalizeReason {
  COMPLETE_REVIEW
  REQUIRED_CHANGES_ADDRESSED
  EXCEPTION_APPROVED
  OTHER
}

model Meeting {
  id                       String                        @id @default(cuid())
  workspaceId              String
  clientName               String
  /// Linked Client row when attributed (email alias, name backfill, or manual).
  clientId                 String?
  /// EMAIL = authoritative; NAME_EXACT = low-confidence backfill; MANUAL = user resolved.
  clientMatchConfidence    MeetingClientMatchConfidence?
  /// Participant emails captured at ingest (Zoom/Teams). Used for client attribution.
  participantEmails        String[]                      @default([])
  meetingType              String
  meetingDate              DateTime
  status                   MeetingStatus                 @default(UPLOADING)
  fileUrl                  String? // S3/R2 storage URL
  /// CV-TR-07: SHA-256 of the canonical transcript serialisation. Must exist before any media delete.
  transcriptSha256         String?
  /// CV-TR-07: set when source media was deleted under DISCARD posture. UI shows this instead of playback.
  mediaDiscardedAt         DateTime?
  sourceFileSha256         String?
  sourceFileName           String?
  sourceFileSize           Int?
  sourceFileMime           String?
  sourceUploadedAt         DateTime?
  transcript               Json? // { segments: [{ startTime, endTime, speaker, text }] }
  extraction               Json? // { topics, recommendations, disclosures, decisions, followUps, evidenceMap }
  searchableText           String? // Indexed text for fast keyword search (transcript + extracted fields)
  finalizedBy              String? // userId who finalized
  finalizedAt              DateTime? // timestamp when finalized
  finalizeReason           FinalizeReason?
  finalizeNote             String?
  finalizedPolicyVersion   Int?
  samplingBucket           String?
  samplingRuleId           String?
  supervisoryOutcome       SupervisoryOutcome?
  outcomeReason            String?                       @db.Text
  outcomeConfidence        Float?
  processedAt              DateTime?
  primaryControlId         String?
  heldReason               SupervisoryHoldReason?
  parkedReason             String?                       @db.Text
  draftReadyAt             DateTime? // timestamp when status changed to DRAFT_READY (for KPI tracking)
  timeToFinalize           Int? // Time-to-Finalize in seconds (draftReadyAt → finalizedAt) for KPI tracking
  readyForCCO              Boolean                       @default(false) // flag indicating meeting is ready for CCO review
  /// Microsoft Graph / SharePoint (Epic 2) — item web URL after auto-deposit
  sharepointItemWebUrl     String?                       @db.Text
  sharepointDepositedAt    DateTime?
  /// Epic 3 — Zoho CRM: explicit Contact record id; optional when name search is enough
  zohoCrmContactId         String?                       @db.Text
  zohoCrmNotePostedAt      DateTime?
  advisorCertifiedAt       DateTime?
  advisorCertifiedByUserId String?
  cmReviewedAt             DateTime?
  cmReviewedByUserId       String?
  ccoSignedOffAt           DateTime?
  ccoSignedOffByUserId     String?
  /// Summary counts when CM completes review: { resolved, noted, escalated }
  cmReviewSummary          Json?
  /// CV-TR-16: this meeting is a correction that replaces the referenced sealed meeting.
  supersedesId             String?
  /// CV-TR-16: this sealed meeting has been replaced by the referenced meeting.
  supersededById           String?                       @unique
  /// CV-TR-16: mandatory narrative reason (stored on original; copied onto replacement).
  supersedeReason          String?                       @db.Text
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  // Relations
  workspace              Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                 Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  versions               Version[]
  auditEvents            AuditEvent[]
  flags                  Flag[]
  resolutionRecords      ResolutionRecord[]
  integrationSyncLogs    IntegrationSyncLog[]
  recordSeals            RecordSeal[]
  advisorCertifiedByUser User?                @relation("MeetingAdvisorCertifiedBy", fields: [advisorCertifiedByUserId], references: [id], onDelete: SetNull)
  cmReviewedByUser       User?                @relation("MeetingCmReviewedBy", fields: [cmReviewedByUserId], references: [id], onDelete: SetNull)
  ccoSignedOffByUser     User?                @relation("MeetingCcoSignedOffBy", fields: [ccoSignedOffByUserId], references: [id], onDelete: SetNull)
  supersedes             Meeting?             @relation("MeetingSupersedesParent", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededByChildren   Meeting[]            @relation("MeetingSupersedesParent")
  supersededBy           Meeting?             @relation("MeetingSupersededByChild", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedesParent       Meeting?             @relation("MeetingSupersededByChild")
  // Note: searchableText is NOT indexed with btree (too large for index)
  // We use PostgreSQL's native full-text search via to_tsvector() in queries
  // The field is limited to 50KB to prevent database issues

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, clientName])
  @@index([workspaceId, clientId])
  @@index([workspaceId, clientMatchConfidence])
  @@index([workspaceId, meetingDate])
  @@index([workspaceId, supervisoryOutcome])
  @@index([supersedesId])
}

model Version {
  id          String   @id @default(cuid())
  meetingId   String
  version     Int // Sequential version number
  editorId    String // userId who made the change
  whatChanged String // Field name and change description
  reason      String? // Optional reason for edit
  timestamp   DateTime @default(now())

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([meetingId, timestamp])
}

// ============================================
// Audit Trail Models (ADR-005)
// ============================================

enum AuditAction {
  UPLOAD
  VIEW
  EDIT
  FINALIZE
  EXPORT
  DELETE
  REMEDIATION_START
  REMEDIATION_UPDATE
  TASK_UPDATE
  EVIDENCE_ADD
  VERIFICATION
  OVERRIDE
  WORKSPACE_CREATED
  INVITE_SENT
  INVITE_RESENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  MEMBER_REMOVED
  ADVISOR_CERTIFIED
  CM_REVIEW_COMPLETED
  CCO_SIGNED_OFF
  WORKFLOW_REVERTED
  DISCLOSURE_SUPPRESSION_ACTIVATED
  DISCLOSURE_SUPPRESSION_DEACTIVATED
  FIRM_PROFILE_APPROVED
  CCO_ACKNOWLEDGED_NEVER_SUPPRESS
  AI_QUERY
  MAILBOX_CONNECTED
  MAILBOX_DISCONNECTED
  MAILBOX_SYNC_STARTED
  MAILBOX_SYNC_COMPLETED
  EVIDENCE_VIEW
  EVIDENCE_TAG
  EMAIL_TRIAGE_RESOLVED
  THREAD_EXPORT
  MEETING_CLIENT_ATTRIBUTED
  RETENTION_POLICY_UPDATED
  MEDIA_POSTURE_SET
  INGEST_PARKED
  INGEST_REPLAYED
  MEDIA_DISCARDED
  RECORD_SEALED
  RECORD_SUPERSEDED
  CANDIDATE_PACK_SCOPE_CONFIRMED
  CANDIDATE_PACK_GENERATED
  CANDIDATE_PACK_APPROVED
  SUPERVISORY_OUTCOME_ASSIGNED
  SUPERVISORY_SAMPLE_SELECTED
  FINDING_VIEWED
}

/// CV-TR-01/02 — append-only ledger entry for immutable audit-pack bytes.
/// The application role receives SELECT/INSERT only at the PostgreSQL layer.
/// `updatedAt` and `deletedAt` exist for schema consistency but application
/// code and the restricted DB role must never mutate them after INSERT.
model RecordSeal {
  id             String    @id @default(cuid())
  workspaceId    String
  meetingId      String
  packHash       String    @unique
  sealedAt       DateTime
  sealedByUserId String
  storageUri     String    @db.Text
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, meetingId])
  @@index([workspaceId, sealedAt])
  @@index([meetingId])
  @@index([expiresAt])
}

/// How Meeting.clientId was resolved. NAME_EXACT is low-confidence (reviewable).
enum MeetingClientMatchConfidence {
  EMAIL
  NAME_EXACT
  MANUAL
}

enum FlagType {
  MISSING_DISCLOSURE
  CONFLICT_LANGUAGE
  MISSING_SUITABILITY_BASIS
  /// Email intelligence taxonomy (Phase 2)
  GUARANTEED_RETURN
  PERFORMANCE_CLAIM
  CLIENT_COMPLAINT
  UNAPPROVED_MARKETING
  TRADE_INSTRUCTION
  FEE_DISPUTE
  OFF_CHANNEL_REFERENCE
  SENSITIVE_PII_SHARE
  GIFTS_ENTERTAINMENT
}

enum FlagSourceType {
  MEETING
  EMAIL
}

enum EvidenceClassificationResult {
  CLEAN
  FLAGGED
}

/// Lifecycle of email classification on EvidenceItem (async QStash job).
enum EvidenceClassificationStatus {
  PENDING
  COMPLETE
  FAILED
}

enum FlagSeverity {
  INFO
  WARN
  CRITICAL
}

/// CV-SI-006 — client-impact materiality on a priority finding.
enum FindingMateriality {
  HIGH
  MEDIUM
  LOW
}

enum FlagStatus {
  OPEN
  IN_REMEDIATION
  PENDING_VERIFICATION
  CLOSED
  CLOSED_ACCEPTED_RISK
}

enum FlagResolutionType {
  ADD_CONTEXT
  DISMISSED_WITH_REASON
  DISCLOSED_ELSEWHERE
  FOLLOW_UP_REQUIRED
  OVERRIDE_APPROVED
}

enum RemediationTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum EvidenceType {
  TRANSCRIPT_SNIPPET
  DOCUMENT_LINK
  OUTREACH_PROOF
  ACKNOWLEDGEMENT
  NOTE
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

enum FlagCreatedByType {
  SYSTEM
  USER
}

/// Layer-2 triage disposition set by Compliance Manager (three-layer sign-off).
enum CmFlagDisposition {
  NONE
  RESOLVED
  NOTED
  ESCALATED
}

model Flag {
  id                String              @id @default(cuid())
  workspaceId       String
  /// Required when sourceType = MEETING; null for EMAIL-sourced flags.
  meetingId         String?
  sourceType        FlagSourceType      @default(MEETING)
  /// Meeting.id when MEETING; CommunicationThread.id when EMAIL.
  sourceId          String
  /// Message-level pointer for email-sourced flags.
  communicationId   String?
  /// Idempotency key (email: `email:{communicationId}:{type}`); null for meeting flags.
  dedupeKey         String?
  type              FlagType
  severity          FlagSeverity        @default(WARN)
  status            FlagStatus          @default(OPEN)
  evidence          Json?
  createdByType     FlagCreatedByType   @default(SYSTEM)
  createdByUserId   String?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  resolutionType    FlagResolutionType?
  resolutionNote    String?
  /// CM triage (resolve / note / escalate) for three-layer workflow.
  cmDisposition     CmFlagDisposition   @default(NONE)
  escalationReason  String?             @db.Text
  cmTriageNote      String?             @db.Text
  cmTriagedAt       DateTime?
  cmTriagedByUserId String?
  /// CV-SI-006 — when set, this flag is (or was) a priority-inbox finding.
  escalatedAt       DateTime?
  assignedToUserId  String?
  reviewDueAt       DateTime?
  materiality       FindingMateriality?
  policyMappingCode String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  meeting          Meeting?          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  communication    Communication?    @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resolutionRecord ResolutionRecord?
  cmTriagedByUser  User?             @relation("FlagCmTriagedBy", fields: [cmTriagedByUserId], references: [id], onDelete: SetNull)
  assignedToUser   User?             @relation("FlagAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId])
  @@index([workspaceId, meetingId])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, assignedToUserId])
  @@index([workspaceId, escalatedAt])
  @@index([meetingId, type])
  @@index([communicationId])
}

model ResolutionRecord {
  id                         String             @id @default(cuid())
  workspaceId                String
  /// Nullable for email-sourced flag remediation.
  meetingId                  String?
  flagId                     String             @unique
  resolutionType             FlagResolutionType
  rationale                  String
  metadata                   Json?
  createdByUserId            String
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  submittedForVerificationAt DateTime?
  closedAt                   DateTime?
  closedByUserId             String?
  overrideReason             String?
  overrideCategory           String?

  flag          Flag           @relation(fields: [flagId], references: [id], onDelete: Cascade)
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks         ActionItem[]
  evidence      EvidenceLink[]
  verifications Verification[]

  @@index([workspaceId])
  @@index([meetingId])
}

/// Classification outcome for an evidence item (email CLEAN is itself audit evidence).
model EvidenceClassification {
  id              String                       @id @default(cuid())
  workspaceId     String
  evidenceItemId  String
  communicationId String?
  contentHash     String
  result          EvidenceClassificationResult
  modelId         String?
  promptVersion   String?
  signalCount     Int                          @default(0)
  rawResponse     Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  deletedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, evidenceItemId, contentHash])
  @@index([workspaceId, result])
  @@index([evidenceItemId])
}

model ActionItem {
  id             String                @id @default(cuid())
  resolutionId   String
  title          String
  status         RemediationTaskStatus @default(OPEN)
  ownerId        String
  dueDate        DateTime
  required       Boolean               @default(true)
  completionNote String?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  evidence   EvidenceLink[]

  @@index([resolutionId])
  @@index([ownerId])
  @@index([dueDate])
}

model EvidenceLink {
  id              String       @id @default(cuid())
  resolutionId    String
  taskId          String?
  type            EvidenceType
  label           String?
  url             String?
  metadata        Json?
  createdByUserId String
  createdAt       DateTime     @default(now())

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  task       ActionItem?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([resolutionId])
  @@index([taskId])
}

model Verification {
  id           String               @id @default(cuid())
  resolutionId String
  reviewerId   String
  decision     VerificationDecision
  note         String?
  decidedAt    DateTime             @default(now())

  resolution ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@index([reviewerId])
}

model AuditEvent {
  id           String      @id @default(cuid())
  workspaceId  String
  userId       String
  action       AuditAction
  resourceType String // "meeting", "workspace", "user"
  resourceId   String
  metadata     Json? // Additional context (field changed, reason, etc.)
  timestamp    DateTime    @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id])
  meetingId String?

  @@index([workspaceId, timestamp])
  @@index([workspaceId, resourceType, resourceId])
  @@index([workspaceId, action])
}

// ============================================
// NextAuth Models (Required for Auth.js v5)
// ============================================

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Relations
  accounts                    Account[]
  sessions                    Session[]
  workspaces                  UserWorkspace[]
  removedWorkspaceMemberships UserWorkspace[] @relation("UserWorkspaceRemovedBy")
  meetingsAdvisorCertified    Meeting[]       @relation("MeetingAdvisorCertifiedBy")
  meetingsCmReviewed          Meeting[]       @relation("MeetingCmReviewedBy")
  meetingsCcoSignedOff        Meeting[]       @relation("MeetingCcoSignedOffBy")
  flagsCmTriaged              Flag[]          @relation("FlagCmTriagedBy")
  flagsAssigned               Flag[]          @relation("FlagAssignedTo")
  invitationsSent             Invitation[]    @relation("InvitationsSent")
  emailAliases                EmailAlias[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Invitation Models
// ============================================

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  token       String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email]) // One invitation per email per workspace
  @@index([token])
  @@index([workspaceId])
  @@index([email])
}

// ============================================
// Integration Models (Epic 6 — IntegrationHub)
// ============================================

enum IntegrationProvider {
  ZOOM
  TEAMS
  SHAREPOINT
  GOOGLE_DRIVE
  SMARTVAULT
  REDTAIL
  WEALTHBOX
  SALESFORCE
  DOCUSIGN
  RIA_IN_A_BOX
  COMPLYSCI
  SLACK
  TEAMS_BOT
  ZOHO_CRM
  M365_MAIL
  GMAIL_MAIL
}

enum IntegrationStatus {
  CONNECTED
  WARNING_RETRYING
  ERROR_ACTION_REQUIRED
  NOT_CONNECTED
}

model IntegrationCredential {
  id                    String              @id @default(cuid())
  workspaceId           String
  provider              IntegrationProvider
  accessTokenEncrypted  String              @db.Text
  refreshTokenEncrypted String?             @db.Text
  expiresAt             DateTime?
  scopes                String?             @db.Text // Comma-separated OAuth scopes
  status                IntegrationStatus   @default(CONNECTED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider, status])
}

model IntegrationConfig {
  id               String              @id @default(cuid())
  workspaceId      String
  provider         IntegrationProvider
  config           Json // folder paths, channel IDs, CRM settings, etc.
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  syncLogs  IntegrationSyncLog[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model IntegrationSyncLog {
  id                  String              @id @default(cuid())
  integrationConfigId String?
  meetingId           String?
  provider            IntegrationProvider
  action              String // note, upload, envelope, etc.
  status              String // pending, success, failed
  attempts            Int                 @default(0)
  errorMessage        String?             @db.Text
  createdAt           DateTime            @default(now())
  completedAt         DateTime?

  integrationConfig IntegrationConfig? @relation(fields: [integrationConfigId], references: [id], onDelete: SetNull)
  meeting           Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([integrationConfigId])
  @@index([meetingId])
  @@index([provider, status])
  @@index([createdAt])
}

// ============================================
// Compliance Cockpit — Firm Disclosure Profile (Epic 8.0)
// ============================================

enum DisclosureCategoryStatus {
  ACTIVE
  SUPPRESSING
  NEVER_SUPPRESS
}

enum FirmProfileStatus {
  DRAFT
  ACTIVE
}

enum FirmProfileVersionType {
  INITIAL_SETUP
  APPROVED
}

enum SuppressionAction {
  ACTIVATED
  DEACTIVATED
}

model FirmProfile {
  id               String            @id @default(cuid())
  workspaceId      String            @unique
  status           FirmProfileStatus @default(DRAFT)
  crdNumber        String?
  ccoName          String?
  advFilingDate    DateTime?
  aumUsd           Decimal?
  advDocumentUrl   String?
  advDocumentKey   String?
  riskFlags        String[]
  setupCompletedAt DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  disclosureCategories DisclosureCategory[]
  suppressionLogs      SuppressionLogEntry[]
  versions             FirmProfileVersion[]

  @@index([workspaceId])
}

model DisclosureCategory {
  id                  String                   @id @default(cuid())
  firmProfileId       String
  slug                String
  status              DisclosureCategoryStatus @default(ACTIVE)
  suppressionEvidence String?
  advItemRef          String?
  advPage             Int?
  description         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@unique([firmProfileId, slug])
  @@index([firmProfileId])
}

model SuppressionLogEntry {
  id               String                    @id @default(cuid())
  workspaceId      String
  firmProfileId    String
  categorySlug     String
  userId           String
  meetingId        String?
  action           SuppressionAction
  previousStatus   DisclosureCategoryStatus?
  newStatus        DisclosureCategoryStatus
  evidenceSnapshot String?
  createdAt        DateTime                  @default(now())

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@index([firmProfileId, createdAt])
  @@index([workspaceId, createdAt])
}

model FirmProfileVersion {
  id               String                 @id @default(cuid())
  firmProfileId    String
  workspaceId      String
  versionType      FirmProfileVersionType
  approvedByUserId String?
  approvedAt       DateTime               @default(now())
  snapshot         Json

  firmProfile FirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@index([firmProfileId, approvedAt])
  @@index([workspaceId])
}

// ============================================
// Evidence Layer + M365 Mail (Epic A subset + Epic B)
// ============================================

enum EvidenceSourceType {
  MEETING
  EMAIL
  MESSAGE
  DOCUMENT
  POLICY
  ATTESTATION
  NOTE
  FINDING_RECORD
}

enum TagCategory {
  ADVICE
  RECOMMENDATION
  COMPLAINT
  FEE
  PERFORMANCE
  MARKETING
  REVIEW
  VULNERABLE_CLIENT
  OFF_CHANNEL
}

enum CommunicationChannel {
  EMAIL_M365
  EMAIL_GMAIL
  WHATSAPP_IMPORT
  SMS_IMPORT
  TEAMS_IMPORT
  SLACK_IMPORT
  OTHER_IMPORT
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ClientStatus {
  CLIENT
  PROSPECT
  FORMER
}

enum MailboxProvider {
  M365
  GMAIL
}

enum MailboxSyncStatus {
  PENDING
  BACKFILLING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum MailboxConsentMode {
  APPLICATION
  DELEGATED
}

enum IngestJobKind {
  BACKFILL
  DELTA
  MESSAGE_IMPORT
}

enum IngestJobStatus {
  QUEUED
  RUNNING
  PAUSED
  DONE
  FAILED
}

enum EmailTriageStatus {
  PENDING
  CONFIRMED
  EXTERNAL
  IRRELEVANT
}

model Client {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  zohoId        String?
  status        ClientStatus @default(CLIENT)
  /// Max of last meeting / last email correspondence (denormalized for dashboards).
  lastContactAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailAliases         EmailAlias[]
  evidenceItems        EvidenceItem[]
  activities           ClientActivity[]
  householdMemberships ClientHouseholdMember[]
  meetings             Meeting[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, lastContactAt])
}

enum HouseholdMemberRole {
  PRIMARY
  SPOUSE
  JOINT
}

/// Links related clients (spouse, joint account holders) for correspondence matching.
model ClientHousehold {
  id          String    @id @default(cuid())
  workspaceId String
  name        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ClientHouseholdMember[]

  @@index([workspaceId])
}

model ClientHouseholdMember {
  id          String              @id @default(cuid())
  householdId String
  clientId    String
  role        HouseholdMemberRole @default(PRIMARY)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  household ClientHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([householdId, clientId])
  @@index([clientId])
  @@index([householdId, role])
}

enum ClientActivityType {
  EMAIL_RECEIVED
  EMAIL_SENT
  EMAIL_INTERNAL
  TRIAGE_ATTACHED
}

/// Client correspondence / activity timeline (email intelligence Phase 1).
model ClientActivity {
  id             String                  @id @default(cuid())
  workspaceId    String
  clientId       String
  type           ClientActivityType
  occurredAt     DateTime
  title          String?
  direction      CommunicationDirection?
  counterparties String[]
  evidenceItemId String?
  threadId       String?
  contentSha256  String?
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, evidenceItemId, clientId])
  @@index([workspaceId, clientId, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([threadId])
}

model EmailAlias {
  id          String    @id @default(cuid())
  workspaceId String
  address     String
  userId      String?
  clientId    String?
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, address, userId, clientId])
  @@index([workspaceId, address])
}

model EvidenceItem {
  id                    String                        @id @default(cuid())
  workspaceId           String
  clientId              String?
  createdById           String?
  sourceType            EvidenceSourceType
  title                 String
  occurredAt            DateTime
  ingestedAt            DateTime                      @default(now())
  contentSha256         String
  storageUri            String?
  /// Keyword index for Ask / search (redacted for EMAIL). Mirrors Meeting.searchableText.
  searchableText        String?                       @db.Text
  /// EMAIL only: PENDING until classify job completes; FAILED after exhausted retries.
  classificationStatus  EvidenceClassificationStatus?
  retentionRuleId       String?
  destructionEligibleAt DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  deletedAt             DateTime?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tags          EvidenceTag[]
  communication Communication?

  @@index([workspaceId, clientId, occurredAt])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, classificationStatus])
}

model EvidenceTag {
  id        String      @id @default(cuid())
  itemId    String
  category  TagCategory
  addedBy   String
  addedAt   DateTime    @default(now())
  removedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  item EvidenceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, category])
}

/// Chunk embeddings for hybrid Ask retrieval (pgvector). Embed redacted text only.
model EvidenceEmbedding {
  id            String                      @id @default(cuid())
  workspaceId   String
  sourceType    EvidenceSourceType
  /// EMAIL: EvidenceItem id. MEETING: Meeting id.
  sourceId      String
  /// EMAIL: evidenceItemId. MEETING: `${meetingId}:${segmentIndex}`
  chunkKey      String
  chunkTextHash String
  /// pgvector column — written/queried via raw SQL only.
  embedding     Unsupported("vector(1536)")
  model         String
  modelVersion  String
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, chunkKey, model])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, sourceId])
}

model CommunicationThread {
  id                 String                 @id @default(cuid())
  workspaceId        String
  channel            CommunicationChannel
  externalThreadId   String?
  subject            String?
  participants       Json
  supervisoryOutcome SupervisoryOutcome?
  outcomeReason      String?                @db.Text
  outcomeConfidence  Float?
  processedAt        DateTime?
  primaryControlId   String?
  heldReason         SupervisoryHoldReason?
  parkedReason       String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Communication[]

  @@index([workspaceId, externalThreadId])
  @@index([workspaceId, supervisoryOutcome])
  @@index([workspaceId, updatedAt])
}

model SupervisorySamplingConfig {
  id                         String    @id @default(cuid())
  workspaceId                String    @unique
  randomPercentage           Int       @default(3)
  adviserRiskEnabled         Boolean   @default(true)
  adviserRiskOpenFlagFloor   Int       @default(2)
  newAdviserEnabled          Boolean   @default(true)
  newAdviserWindowDays       Int       @default(30)
  timeSinceLastReviewEnabled Boolean   @default(true)
  reviewStalenessDays        Int       @default(30)
  manualSelectionEnabled     Boolean   @default(true)
  controlSamplingPolicy      Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Communication {
  id                String                 @id @default(cuid())
  threadId          String
  evidenceItemId    String                 @unique
  direction         CommunicationDirection
  sentAt            DateTime
  fromAddress       String
  toAddresses       String[]
  ccAddresses       String[]
  internetMessageId String?                @unique
  bodyText          String                 @db.Text
  bodyHtml          String?                @db.Text
  inReplyTo         String?
  referencesHeader  String?                @db.Text
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  thread       CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceItem        @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  flags        Flag[]

  @@index([threadId, sentAt])
}

model Attachment {
  id              String    @id @default(cuid())
  communicationId String
  filename        String
  mimeType        String
  contentSha256   String
  storageUri      String
  sizeBytes       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model MailboxConnection {
  id               String             @id @default(cuid())
  workspaceId      String
  provider         MailboxProvider    @default(M365)
  mailboxAddress   String
  consentMode      MailboxConsentMode @default(APPLICATION)
  scopeFolders     String[]
  backfillFrom     DateTime?
  status           MailboxSyncStatus  @default(PENDING)
  encryptedToken   String?            @db.Text
  deltaCursor      String?            @db.Text
  lastSyncAt       DateTime?
  lastErrorMessage String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ingestJobs IngestJob[]

  @@unique([workspaceId, mailboxAddress])
  @@index([workspaceId, status])
}

model IngestJob {
  id           String          @id @default(cuid())
  workspaceId  String
  connectionId String?
  importFileId String?
  kind         IngestJobKind
  status       IngestJobStatus @default(QUEUED)
  cursor       String?         @db.Text
  stats        Json            @default("{}")
  errorMessage String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MailboxConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([connectionId, kind, status])
}

model EmailTriageItem {
  id          String            @id @default(cuid())
  workspaceId String
  address     String
  status      EmailTriageStatus @default(PENDING)
  userId      String?
  clientId    String?
  resolvedBy  String?
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, address])
  @@index([workspaceId, status])
}

// ============================================
// Lead/Trial Request Models
// ============================================

model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  company   String?
  source    String? // Marketing source (e.g., "complyvault.co", "complyvault.co/uk")
  ipAddress String?
  createdAt DateTime @default(now())

  @@unique([email]) // One lead per email (prevent duplicates)
  @@index([email])
  @@index([createdAt])
}
