{
  "name": "ria-compliance-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/vercel-build.mjs",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:backup": "bash ./scripts/backup-database.sh",
    "db:create-migration": "node ./scripts/create-migration.js",
    "db:run-migrations": "node ./scripts/run-migrations.js",
    "dev": "next dev --turbo",
    "postinstall": "prisma generate",
    "preview": "prisma migrate deploy && next build && next start",
    "start": "next start",
    "db:seed-demo": "npx tsx scripts/seed-demo.ts",
    "db:seed-advizorstack": "npx tsx scripts/seed-supervision-advizorstack.ts --confirm",
    "db:seed-riact": "npx tsx scripts/seed-riact.ts --confirm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
